{
  "id": "ep_008",
  "title": "PLACE: Veranda",
  "acts": [
    {
      "id": "act_1",
      "title": "PLACE: The School Veranda",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The boatman pushes a small wooden name-plate across the veranda floor; the carved letters are fresh and dark with sap.",
              "stage_directions": ""
            },
            {
              "character": "char_boatman",
              "place": "place_veranda",
              "dialogue": "I want my son’s name in the book tomorrow, or my family loses our rice share.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Kamnan Noi arrives, sits at the edge of the veranda, opens his public ledger and traces a column of numbers with his finger.",
              "stage_directions": ""
            },
            {
              "character": "char_mor_duang",
              "place": "place_veranda",
              "dialogue": "The noon hour is cracked; the child’s birth minute feeds the eclipse.",
              "stage_directions": "without looking up"
            },
            {
              "character": "char_sangwan",
              "place": "place_veranda",
              "dialogue": "The name is already cut on the family boat.",
              "stage_directions": "steps onto the veranda, hands empty"
            },
            {
              "character": "char_monk",
              "place": "place_veranda",
              "dialogue": "A name given under a bad sky is still a name; the temple's coming blessing can cover it.",
              "stage_directions": "sighs"
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_045"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_monk",
              "place": "place_veranda",
              "dialogue": "A name given under a bad sky is still a name; the temple can bless it.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Kamnan Noi takes a smaller, private ledger from his bag and writes a single line in it.",
              "stage_directions": ""
            },
            {
              "character": "char_boatman",
              "place": "place_veranda",
              "dialogue": "Lek, read the district notice about the subsidy; it says the morning registration must coincide with the blessing.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_131"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek reads the notice aloud; the words about delay forfeiting allocation echo under the zinc roof. The Fire Stoker watches the sap on the name-plate, judging its darkness against the memory of other woods.",
              "stage_directions": ""
            },
            {
              "character": "char_pawnshop_appraiser",
              "place": "place_veranda",
              "dialogue": "A name is just a word; the real value is in the land title it attaches to.",
              "stage_directions": "polishes a lens"
            },
            {
              "character": "char_mor_duang",
              "place": "place_veranda",
              "dialogue": "",
              "stage_directions": "stands, picks up his compass, walks to the top of the veranda steps, looks at the sun’s angle on the pond"
            }
          ]
        }
      ],
      "decision": {
        "line": {
          "character": "char_pricha",
          "place": "place_veranda",
          "dialogue": "",
          "stage_directions": ""
        },
        "choices": [
          {
            "description": "I ask the monk to bless the name-plate right here on the veranda.",
            "difficulty": "easy",
            "attribute": "attr_merit_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see the monk sprinkle water over the wood; the sap darkens.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 1
