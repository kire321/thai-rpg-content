          {
            "description": "I wade into the canal to try and retrieve the floating almanac.",
            "difficulty": "medium",
            "attribute": "attr_heart_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_river_post",
                "dialogue": "I grab the sodden book and bring it back to the platform.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_river_post",
                "dialogue": "I slip on the muddy bank; the almanac drifts out of reach.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 0
            }
          },
          {
            "description": "I ask the boatman's wife to decide if we should wait for moon-rise.",
            "difficulty": "hard",
            "attribute": "attr_word_hoard",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_river_post",
                "dialogue": "I hear her say clearly she will wait, and she takes back the name-plate.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_river_post",
                "dialogue": "I see her look at the officer's watch and silently shake her head.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 0
            }
          }
        ]
      }
    },
    {
      "id": "act_3",
      "title": "PLACE: The Salt Store",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "At The Salt Store, the District Officer writes the child’s name in the red-chalk ledger under glass.",
              "stage_directions": ""
            },
            {
              "character": "char_district_officer",
              "place": "place_salt_store",
              "dialogue": "Sign as witness next to the entry, Lek.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "The Salt Clerk measures out grey salt into a cloth bag but does not hand it over; he waits.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "The boatman’s wife stands by the brick bins, her eyes on the ledger behind the glass.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "Kamnan Noi enters the store and places his brass compass on the counter beside the ledger.",
              "stage_directions": ""
            },
            {
              "character": "char_mor_duang",
              "place": "place_salt_store",
              "dialogue": "Starting now, the sequence is fixed—signing binds the name to a cracked hour forever.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_288"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_district_officer",
              "place": "place_salt_store",
              "dialogue": "The sequence is the subsidy—no signature, no rice.",
              "stage_directions": ""
            },
            {
              "character": "char_well_keeper",
              "place": "place_salt_store",
              "dialogue": "The three families are already at the granary, asking when the chits will come.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "Kamnan Noi opens his private ledger to a page filled with tiny, precise numbers and birth coordinates — a listener could hear the ghost of water in the faded ink.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_087"
