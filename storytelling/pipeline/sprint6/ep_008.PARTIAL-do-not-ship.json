                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see the monk shake his head and put his water bowl away.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 0
            }
          },
          {
            "description": "I propose we inscribe the name in the boatman's family ledger first.",
            "difficulty": "medium",
            "attribute": "attr_ledger",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I watch the boatman open his own book and carefully write the characters.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see the boatman's hands shake; he cannot make the ink stick to the page.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 0
