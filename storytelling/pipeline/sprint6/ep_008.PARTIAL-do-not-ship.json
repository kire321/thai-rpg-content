              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The boatman’s wife receives the rice chits from the delivery boy; she does not smile.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Kamnan sits in his usual spot at the edge of the veranda, his compass in his lap.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "He takes out a clean sheet of paper and begins drawing two charts, side by side.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "He works the fine-nib pen; the lines are exact curves and angles that will soon be burned to ash.",
