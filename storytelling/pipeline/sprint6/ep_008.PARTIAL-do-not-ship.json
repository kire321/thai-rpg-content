            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "He strikes a match and burns the folded chart over a clay dish; the ash flakes onto the floorboards, and you find yourself watching the flakes settle, knowing they will soon be part of the pond's silt.",
              "stage_directions": ""
            }
          ]
        },
