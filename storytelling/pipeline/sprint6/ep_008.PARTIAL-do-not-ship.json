          },
          {
            "description": "I suggest we place the name-plate in the pond to test the water's acceptance.",
            "difficulty": "hard",
            "attribute": "attr_heart_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see the wood float steadily; the fire stoker nods.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see the wood tilt and sink a little; Kamnan Noi notes it in his ledger.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 0
            }
          }
        ]
      }
    },
    {
      "id": "act_2",
      "title": "PLACE: River post",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_river_post",
              "dialogue": "The district officer arrives at the river post, his bicycle leaning against the bamboo pole holding the oilskin-wrapped letters.",
              "stage_directions": ""
            },
            {
              "character": "char_district_officer",
              "place": "place_river_post",
              "dialogue": "\"Give me the registration paper.\" [The boatman's wife hands him a folded sheet with the child's carved name.]",
              "stage_directions": ""
            },
            {
              "character": "char_district_officer",
              "place": "place_river_post",
              "dialogue": "Is the chart cast?",
              "stage_directions": "looks at Kamnan"
            },
            {
              "character": "char_mor_duang",
              "place": "place_river_post",
              "dialogue": "I have not cast it; the sky at noon is blind.",
              "stage_directions": "shakes his head"
            },
            {
              "character": "char_district_officer",
              "place": "place_river_post",
              "dialogue": "Village superstition. The clock is the only chart that matters.",
              "stage_directions": "laughs, taps his watch"
            },
            {
              "character": "char_district_officer",
              "place": "place_river_post",
              "dialogue": "Stop. The clock is the only chart. I need a witness signature on the form by sunset today, or the rice chits for three families will be held.",
              "stage_directions": "turns to Lek"
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_209"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_river_post",
              "dialogue": "The boatman's wife presses the small name-plate into Lek's hands; the wood is still slightly damp.",
              "stage_directions": ""
            },
            {
              "character": "char_mor_duang",
              "place": "place_river_post",
              "dialogue": "",
              "stage_directions": "walks to the edge of the platform and takes a sidereal almanac from his sleeve"
            },
            {
              "character": "char_mor_duang",
              "place": "place_river_post",
              "dialogue": "Please—these correspond to moon-rise, not noon.",
              "stage_directions": "shows her a page of signs, pointing to a cluster"
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_161"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_river_post",
              "dialogue": "The bamboo pole holds seventeen oilskin-wrapped letters.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_river_post",
              "dialogue": "Six have red wax seals, four have blue.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_river_post",
              "dialogue": "The rest remain unmarked.",
              "stage_directions": ""
            }
          ]
        }
      ],
      "decision": {
