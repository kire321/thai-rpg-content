            "description": "I quickly sign the form before the officer changes his mind.",
            "difficulty": "easy",
            "attribute": "attr_deference",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_river_post",
                "dialogue": "I see the officer snap the form into his leather case with a satisfied click.",
                "stage_directions": ""
              },
