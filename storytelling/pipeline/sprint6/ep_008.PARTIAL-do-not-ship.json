            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Kamnan Noi puts his compass away, closes all his ledgers, and watches the water until the light fails; the rice chits glow on the veranda rail, their arrival timed to the failing light.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Kamnan Noi watches the water until the light fails, the ash from the burnt chart now part of the pond's silt, the name written under a sky only the stars now remember.",
              "stage_directions": ""
            }
          ]
        }
