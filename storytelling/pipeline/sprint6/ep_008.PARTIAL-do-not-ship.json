          "type": "narrative",
          "lines": [
            {
              "character": "char_mor_duang",
              "place": "place_salt_store",
              "dialogue": "A name, a time, and a single word in faded ink: 'water'.",
              "stage_directions": "shows Lek one line"
            },
            {
              "character": "char_narrator",
              "place": "place_salt_store",
              "dialogue": "He closes the book. Lek looks at the red-chalk entry, at the wife's face, at the officer's pen waiting on the glass. Kamnan's private ledger holds the coordinates of seventeen births; the paper is brittle, the ink fading, and he knows no one will copy them out again.",
              "stage_directions": ""
            }
          ]
        }
      ],
