                "dialogue": "I see Pom keep the book closed and look at the canal.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 0
            }
          },
          {
            "description": "Ask the Monk to bless the letter's journey now that it is gone.",
            "difficulty": "medium",
            "attribute": "attr_merit_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_salt_store",
                "dialogue": "I see the Monk chant a short blessing toward the departing boat.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_salt_store",
                "dialogue": "I see the Monk continue his silence, his chant complete.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 0
            }
          },
          {
            "description": "Take Pom's steel pen from the notebook and place it in his hand.",
            "difficulty": "hard",
            "attribute": "attr_heart_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_salt_store",
                "dialogue": "I feel Pom's fingers close around the pen firmly.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_salt_store",
                "dialogue": "I feel the pen stay cold and loose in his grasp.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 0
            }
          }
        ]
      }
    }
  ]
