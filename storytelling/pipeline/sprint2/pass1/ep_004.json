              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The plate is smooth and blank.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "No letter accompanies it.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "A separate slip of paper bears a date: the next mail boat’s arrival, two days hence.",
              "stage_directions": ""
            },
            {
              "character": "char_monk",
              "place": "place_veranda",
              "dialogue": "The plate is blank, but the bureau demands a reply. How do we proceed?",
              "stage_directions": ""
            },
            {
              "character": "char_pond_diver",
              "place": "place_veranda",
              "dialogue": "ไม่เหนื่อยเหรอ?",
