    {
      "id": "act_1",
      "title": "The Blank Plate",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The envelope from Bangkok lies on the veranda floorboards between Lek’s feet and Phum’s stool.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The Pond Diver picks it up, turns it over, and places it on Lek’s open ledger.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The print bureau’s seal is intact, but the paper around it is soft from handling.",
              "stage_directions": ""
            },
            {
              "character": "char_pricha",
              "place": "place_veranda",
              "dialogue": "Do you expect correspondence?",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Phum cleans his lens on his sleeve and looks at the envelope but does not touch it.",
              "stage_directions": ""
            },
            {
              "character": "char_phum",
              "place": "place_veranda",
              "dialogue": "I want to know what they are asking for, and it will cost me a trip to the letter-writer.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "He says he does not.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The Monk arrives from the temple hall, holding a palm-leaf manuscript.",
              "stage_directions": ""
            },
            {
              "character": "char_monk",
              "place": "place_veranda",
              "dialogue": "Let us open it.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek breaks the seal.",
              "stage_directions": ""
            },
            {
              "character": "char_pond_diver",
              "place": "place_veranda",
              "dialogue": "โทรกลับหาพี่ด้วยนะ.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek gives a call to him, but receives no answer.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_020"
        },
        {
          "type": "narrative",
          "lines": [
