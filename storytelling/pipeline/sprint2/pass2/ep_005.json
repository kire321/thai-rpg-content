{
  "id": "ep_005",
  "title": "The Declaration",
  "acts": [
    {
      "id": "act_1",
      "title": "The Notice",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek is the teacher of the veranda school, kneeling on the worn floorboards with the school's tin document box open before him, while The District Officer stands straight in crisp uniform, tapping a bamboo pointer against a freshly pasted notice on the pillar.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Phra Kam sits perfectly still in faded robes by the pond's edge with his back to the veranda, a small black notebook beside him, and Wan stands in the shadow of the doorway with a cloth in her hands, watching silently.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The Boatman is a lean man in loose clothes, sitting on the canal bank a short distance away, mending a fishing net in his lap.",
              "stage_directions": ""
            },
            {
              "character": "char_district_officer",
              "place": "place_veranda",
              "dialogue": "Produce the monk's temple papers within three days, or the fine will be levied on this school.",
              "stage_directions": ""
            },
            {
              "character": "char_boatman",
              "place": "place_veranda",
              "dialogue": "ไม่ไปไหนเหรอ",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek looks up from the box and shakes his head, his search stalled.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_283"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_sangwan",
              "place": "place_veranda",
              "dialogue": "ชอบสุดๆ",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek glances at Phra Kam's serene stillness, then turns back to face The District Officer.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_317"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The District Officer’s notice is pasted over a crack in the veranda pillar, its red stamp bleeding into the old wood.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Phra Kam opens his small black notebook and writes a single word with a charcoal pencil, then closes it.",
              "stage_directions": ""
            }
          ]
        }
      ],
      "decision": {
        "line": {
          "character": "char_district_officer",
          "place": "place_veranda",
          "dialogue": "Produce the papers or face the fine.",
          "stage_directions": ""
        },
        "choices": [
          {
            "description": "Ask Wan to search the household chests for any old letters or temple seals.",
            "difficulty": "easy",
            "attribute": "attr_word_hoard",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I find a faded envelope with a temple's wax seal among the household papers.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I find no letters or seals, only a torn mat and some dried leaves.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 0
            }
          },
          {
            "description": "Quietly ask The Boatman if he knows where Phra Kam's belongings were stored when he first arrived.",
            "difficulty": "medium",
            "attribute": "attr_heart_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I learn the monk's small bundle is tucked under the veranda floorboards.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I learn the bundle was lost in the canal floods last season.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 0
            }
          },
          {
            "description": "Interrupt Phra Kam's meditation by the pond and ask him directly for the name of his former temple.",
            "difficulty": "hard",
            "attribute": "attr_deference",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I hear him whisper a temple's name before he closes his notebook.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see him shake his head once and turn his face away.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 0
            }
          }
        ]
      }
    },
    {
      "id": "act_2",
      "title": "The Pawnshop",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "The Pawnshop Appraiser, a stout man in a sleeveless shirt, stands on the pawnshop landing with a small scale weighing a bundle of gold tied with red string, while Lek walks with Phra Kam along the canal toward the pawnshop.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "The Boatman poles his boat alongside them, keeping pace.",
              "stage_directions": ""
            },
            {
              "character": "char_pricha",
              "place": "place_pawnshop",
              "dialogue": "Do you have any document from your old temple?",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "Phra Kam shakes his head once.",
              "stage_directions": ""
            },
            {
              "character": "char_pawnshop_appraiser",
              "place": "place_pawnshop",
              "dialogue": "มีขายที่",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "Lek scans the shelves, looking for anything that could serve as proof.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_050"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "At the pawnshop landing, The Pawnshop Appraiser is weighing a bundle of red-stringed gold.",
              "stage_directions": ""
            },
            {
              "character": "char_boatman",
              "place": "place_pawnshop",
              "dialogue": "พูดจริงนะ",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "Lek nods firmly, his determined expression unchanged, and approaches the appraiser's counter.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_124"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_pricha",
              "place": "place_pawnshop",
              "dialogue": "Have you ever taken a monk’s bowl or robe as pledge?",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_pawnshop",
              "dialogue": "The Pawnshop Appraiser sets down the scale and looks at Lek with a blank expression.",
              "stage_directions": ""
            },
            {
              "character": "char_pawnshop_appraiser",
              "place": "place_pawnshop",
              "dialogue": "ไม่เคย",
              "stage_directions": ""
            }
          ]
        }
      ],
      "decision": {
        "line": {
          "character": "char_pawnshop_appraiser",
          "place": "place_pawnshop",
          "dialogue": "Find proof of identity or find something of value.",
          "stage_directions": ""
        },
        "choices": [
          {
            "description": "Offer the school's tin document box itself as a temporary pledge for a loan.",
            "difficulty": "easy",
            "attribute": "attr_ledger",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "I receive a pawn ticket and a few silver coins from the appraiser.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "The appraiser pushes the box back and tells me it is worthless tin, then sends me away.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 0
            }
          },
          {
            "description": "Ask the appraiser to show the records of pledges to find any monk's bowl.",
            "difficulty": "medium",
            "attribute": "attr_word_hoard",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "I spot an entry for a monk's bowl pawned by a traveler last year.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "I see only lists of knives and spoons, no religious items.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 0
            }
          },
          {
            "description": "Suggest Phra Kam temporarily surrender his notebook to establish its provenance.",
            "difficulty": "hard",
            "attribute": "attr_merit_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "I see the appraiser examine the notebook and nod, recognizing its old paper.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_pawnshop",
                "dialogue": "I see Phra Kam's hand close over the notebook and he turns away.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 0
            }
          }
        ]
      }
    },
    {
      "id": "act_3",
      "title": "The Rice Ledger",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "The Tax Clerk stamps a ledger page forcefully at a high wooden counter, while The Grain Clerk stacks wooden tallies in the corner, his sleeves rolled up.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "Inside the office, the air is thick with mildew and ink.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "The Tax Clerk's fingers are stained with ink.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "Lek approaches the counter and asks about registration for a monk without a temple.",
              "stage_directions": ""
            },
            {
              "character": "char_grain_clerk",
              "place": "place_rice_ledger",
              "dialogue": "อยู่จังหวัดอะไร",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "Lek hesitates, unable to name a province for Phra Kam.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_126"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "The Grain Clerk says monks are registered by the Sangha, not the tax office, and the Tax Clerk adds that for a fine, a name can be entered into the residence book, as he slides the heavy ledger toward Lek, open to a column of thumbprints, and The District Officer enters and stands behind him.",
              "stage_directions": ""
            },
            {
              "character": "char_tax_clerk",
              "place": "place_rice_ledger",
              "dialogue": "ทุกคนรู้จักมัน",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_rice_ledger",
              "dialogue": "The District Officer nods in agreement with the clerk, acknowledging the regulation.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_113"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_district_officer",
              "place": "place_rice_ledger",
              "dialogue": "Have you found the papers?",
              "stage_directions": ""
            },
            {
              "character": "char_district_officer",
              "place": "place_rice_ledger",
              "dialogue": "If there is no paper, there is no person for the ledger.",
              "stage_directions": ""
            }
          ]
        }
      ],
      "decision": {
        "line": {
          "character": "char_tax_clerk",
          "place": "place_rice_ledger",
          "dialogue": "Enter a name in the ledger or leave it blank.",
          "stage_directions": ""
        },
        "choices": [
          {
            "description": "Use the school's ink and stamp to create a temporary residence certificate on the spot.",
            "difficulty": "easy",
            "attribute": "attr_ledger",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I place the school's stamp on a fresh sheet and hand it to the clerk.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I am told the school's stamp holds no authority for residence.",
                "stage_directions": ""
              },
              "attribute": "attr_ledger",
              "delta": 0
            }
          },
          {
            "description": "Propose recording Phra Kam as a seasonal laborer for the veranda's rice harvest.",
            "difficulty": "medium",
            "attribute": "attr_word_hoard",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I see the Grain Clerk nod and make a note in the labor tally.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I am reminded that monks cannot be entered as laborers.",
                "stage_directions": ""
              },
              "attribute": "attr_word_hoard",
              "delta": 0
            }
          },
          {
            "description": "Request that Phra Kam himself come forward and place his thumbprint in the ledger column.",
            "difficulty": "hard",
            "attribute": "attr_deference",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I watch him approach the counter and press his thumb to the page.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_rice_ledger",
                "dialogue": "I see him remain by the door, his hands folded in his robe.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 0
            }
          }
        ]
      }
    },
    {
      "id": "act_4",
      "title": "The Declaration",
      "segments": [
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Back on the veranda, the afternoon light slants across the pond, and The District Officer waits with his pointer on his shoulder, while the Boatman ties his boat to the veranda post and Lek places the school’s tin box on the floor between them.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "He takes out a blank sheet and his pen, writes a line, and reads it aloud: he declares Phra Kam a ward of the veranda.",
              "stage_directions": ""
            },
            {
              "character": "char_sangwan",
              "place": "place_veranda",
              "dialogue": "มีอะไรเข้าตา",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek pauses his reading and looks at her, blinking in the slanting light, then continues.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_203"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek says the veranda is a place of teaching, and a teacher may host a guest, and The District Officer laughs, asking if a guest eats from the school's rice, then Phra Kam takes the rusted spoon from his robe and holds it flat on his palm.",
              "stage_directions": ""
            },
            {
              "character": "char_boatman",
              "place": "place_veranda",
              "dialogue": "ขอไม้จิ้มฟันหน่อย",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The District Officer shakes his head at the spoon, turns, and walks down the steps without another word.",
              "stage_directions": ""
            }
          ]
        },
        {
          "type": "tag",
          "tag": "tag_060"
        },
        {
          "type": "narrative",
          "lines": [
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Phra Kam looks at the spoon in his hand and puts it back into his robe.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "The veranda is quiet, except for the sound of the Boatman adjusting his net.",
              "stage_directions": ""
            },
            {
              "character": "char_narrator",
              "place": "place_veranda",
              "dialogue": "Lek watches the District Officer's boat drift away.",
              "stage_directions": ""
            }
          ]
        }
      ],
      "decision": {
        "line": {
          "character": "char_phra_kam",
          "place": "place_veranda",
          "dialogue": "Accept the declaration or refuse it.",
          "stage_directions": ""
        },
        "choices": [
          {
            "description": "Ask Phra Kam to add his mark or a word to the declaration paper.",
            "difficulty": "easy",
            "attribute": "attr_merit_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see him take the pen and write a single character beside my name.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see him close the notebook and shake his head, offering no mark.",
                "stage_directions": ""
              },
              "attribute": "attr_merit_water",
              "delta": 0
            }
          },
          {
            "description": "Suggest Phra Kam use his spoon to share a portion of rice from the school's pot.",
            "difficulty": "medium",
            "attribute": "attr_heart_water",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I watch him scoop a small portion of rice and eat it silently.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see him return the spoon to his robe without touching the food.",
                "stage_directions": ""
              },
              "attribute": "attr_heart_water",
              "delta": 0
            }
          },
          {
            "description": "Propose that Phra Kam's notebook entry be read aloud as his response to the declaration.",
            "difficulty": "hard",
            "attribute": "attr_deference",
            "pass_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I hear him read a line from his notebook about gratitude and place.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 1
            },
            "fail_outcome": {
              "line": {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I see him close the book and say nothing, his face unreadable.",
                "stage_directions": ""
              },
              "attribute": "attr_deference",
              "delta": 0
            }
          }
        ]
      }
    }
  ]
}