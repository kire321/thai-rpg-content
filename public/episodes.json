      {
        "id": "act_2",
        "title": "The Salt and the Fire",
        "segments": [
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "Present: Lek, Kamnan Noi, The Funeral Timekeeper.",
                "stage_directions": ""
              },
              {
                "character": "char_boatman",
                "place": "place_veranda",
                "dialogue": "I burned the log because the widow paid me double to lie.",
                "stage_directions": "entering barefoot, salt-crusted shirt clinging to his shoulders, carrying a splintered oar wrapped in cloth"
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "Why are you telling me now?",
                "stage_directions": ""
              },
              {
                "character": "char_boatman",
                "place": "place_veranda",
                "dialogue": "The fire scared me — the house fell at 3:58, same as the tide.",
                "stage_directions": ""
              },
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "Kamnan Noi writes the fire’s time in his small ledger.",
                "stage_directions": ""
              }
            ]
          },
          {
            "type": "tag",
            "tag": "tag_083"
          },
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_salt_clerk",
                "place": "place_veranda",
                "dialogue": "The widow traded her last rice chits for salt the night before the fire.",
                "stage_directions": "arriving barefoot, holding a pink salt chit, pressing it into the Boatman’s palm"
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "Did you see the clock?",
                "stage_directions": ""
              },
              {
                "character": "char_salt_clerk",
                "place": "place_veranda",
                "dialogue": "I don’t read time — only salt — but the lantern was lit when I left.",
                "stage_directions": "a woman with cracked heels"
              }
            ]
          },
          {
            "type": "tag",
            "tag": "tag_230"
          },
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_pawnshop_appraiser",
                "place": "place_veranda",
                "dialogue": "The land was already mortgaged — the widow knew she’d lose.",
                "stage_directions": "walking up, holding a deed, waving it with a pawn string still tied"
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "Why did she burn the house?",
                "stage_directions": ""
              },
              {
                "character": "char_pawnshop_appraiser",
                "place": "place_veranda",
                "dialogue": "Maybe she wanted the truth to burn too.",
                "stage_directions": "a man in a stiff collar"
              },
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "That’s really easy to guess, I think — but I say nothing.",
                "stage_directions": ""
              }
            ]
          }
        ],
