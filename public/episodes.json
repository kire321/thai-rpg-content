    "acts": [
      {
        "id": "act_1",
        "title": "The Red Ink",
        "segments": [
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "The Funeral Timekeeper stands on the school veranda with a red-ink correction in hand, and I know right away it’s about the widow’s husband.",
                "stage_directions": ""
              },
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "I hear the soft tap of his sandal against the wood, and I look up to see a small man in grey cloth, holding a ledger open to a line crossed out in red, then rewritten in black.",
                "stage_directions": ""
              },
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "He steps forward without greeting.",
                "stage_directions": ""
              },
              {
                "character": "char_funeral_timekeeper",
                "place": "place_veranda",
                "dialogue": "The death was at 4:07 AM, not 4:13, and the land audit begins tomorrow.",
                "stage_directions": ""
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "Why the record changed now, six days after the coffin left?",
                "stage_directions": ""
              },
              {
                "character": "char_funeral_timekeeper",
                "place": "place_veranda",
                "dialogue": "The tide log shows the boat arrived at 4:08, so the body must have died earlier. That’s no problem — the water doesn’t lie.",
                "stage_directions": "tapping the red ink"
              }
            ]
          },
          {
            "type": "tag",
            "tag": "tag_288"
          },
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_narrator",
                "place": "place_veranda",
                "dialogue": "I feel the weight of his words, but the doubt stays.",
                "stage_directions": ""
              },
              {
                "character": "char_funeral_timekeeper",
                "place": "place_veranda",
                "dialogue": "She needs it true. But only if it’s written.",
                "stage_directions": "leaning in"
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I’ll need proof — a tide stamp, a boat log.",
                "stage_directions": ""
              }
            ]
          },
          {
            "type": "tag",
            "tag": "tag_330"
          },
          {
            "type": "narrative",
            "lines": [
              {
                "character": "char_funeral_timekeeper",
                "place": "place_veranda",
                "dialogue": "The boatman burned his log. He said the water lied.",
                "stage_directions": ""
              },
              {
                "character": "char_pricha",
                "place": "place_veranda",
                "dialogue": "I hear that, and I’m happy to hear it — because if the water lied, then maybe the ink can too.",
                "stage_directions": ""
              }
            ]
          }
        ],
        "decision": {
          "line": {
            "character": "char_funeral_timekeeper",
            "place": "place_veranda",
            "dialogue": "Will you file it or not?",
            "stage_directions": ""
